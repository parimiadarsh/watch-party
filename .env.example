# Copy to .env in the repo root (same folder as docker-compose.yml)
# docker compose reads these automatically.

# Public port (only the frontend container is published)
HTTP_PORT=80

# Google OAuth Web client ID (optional — guest mode works without it)
# Must match in Google Cloud Console Authorized JavaScript origins, e.g.:
#   http://YOUR_VM_IP
#   https://your-machine.ts.net
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Session signing secret (min ~32 characters; change in production)
JWT_SECRET=change-me-in-production-min-32-characters!!

# --- GCR (Google Container Registry) — for push / pull scripts ---
# GCP project id (e.g. my-watch-party-prod)
GCP_PROJECT_ID=
# Image tag (e.g. latest)
IMAGE_TAG=latest
# If your images in GCR use short names (must match what you pushed):
# GCR_BACKEND_REPO=watchparty-back
# GCR_MIDDLEWARE_REPO=watchparty-mid
# GCR_FRONTEND_REPO=watchparty-front
# Defaults when unset: watch-party-backend / watch-party-middleware / watch-party-frontend
